{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jsontext",
  "compatibility_date": "2026-09-18",
  "main": "src/index.js",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/verify", "/callback", "/discord"]
  }
}